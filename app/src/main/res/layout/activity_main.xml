<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/container"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/liner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        android:background="@color/sig_yellow"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/logo" />
    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_height="match_parent"
        android:id="@+id/linear">

        <fragment
            android:tag="MainFragment"
            android:id="@+id/ProjectFragment"
            android:name="org.tensorflow.lite.examples.detection.PageFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="20dp"
            android:layout_weight="7"
            tools:layout="@layout/fragment_page" />

    </LinearLayout>





    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/find_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/focus"
            android:drawableTop="@drawable/search_image"
            android:text="상품인식"
            android:fontFamily="@font/na_bold"/>


        <Button
            android:id="@+id/basket_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/sig_yellow"
            android:drawableTop="@drawable/shopping_bag_image"
            android:fontFamily="@font/na_bold"
            android:gravity="center"
            android:text="장바구니" />

        <Button
            android:id="@+id/favorite_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/sig_yellow"
            android:drawableTop="@drawable/heart_image"
            android:fontFamily="@font/na_bold"
            android:gravity="center"
            android:text="즐겨찾기" />

        <Button
            android:id="@+id/setting_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/sig_yellow"
            android:drawableTop="@drawable/setting_image"
            android:fontFamily="@font/na_bold"
            android:gravity="center"
            android:text="도움말" />

    </LinearLayout>

</LinearLayout>